<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Housing Booking - Community Housing Platform</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Hero Section -->
  <div class="housing-booking-hero">
    <div class="hero-icon">📅</div>
    <h1>Book Your Housing</h1>
    <p>Select your dates and find the perfect community for you</p>
  </div>

  <!-- Booking Calendar -->
  <div class="booking-calendar-container">
    <div class="calendar-controls">
      <button class="btn-calendar-nav" id="prevBtn">← Previous Month</button>
      <h2 id="calendar-month">April 2025</h2>
      <button class="btn-calendar-nav" id="nextBtn">Next Month →</button>
    </div>

    <div class="booking-calendar">
      <div class="calendar-header-row">
        <div class="calendar-header-cell">Mon</div>
        <div class="calendar-header-cell">Tue</div>
        <div class="calendar-header-cell">Wed</div>
        <div class="calendar-header-cell">Thu</div>
        <div class="calendar-header-cell">Fri</div>
        <div class="calendar-header-cell">Sat</div>
        <div class="calendar-header-cell">Sun</div>
      </div>

      <div class="calendar-body" id="calendarBody">
        <!-- Calendar dates will be generated by JavaScript -->
      </div>
    </div>

    <!-- Selected Dates Info -->
    <div class="selected-dates-info">
      <p id="checkInText"><strong>Check-in:</strong> Select a date</p>
      <p id="checkOutText"><strong>Check-out:</strong> Select a date</p>
      <p id="nightsText"><strong>Total Nights:</strong> 0</p>
      <a href="/communities" class="btn btn-primary" id="findBtn" style="margin-top: 1rem; display: inline-block;" disabled style="opacity: 0.5;">
        Find Communities for These Dates
      </a>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script>
    let checkInDate = null;
    let checkOutDate = null;
    let currentYear = 2025;
    let currentMonth = 3; // April = 3 (0-indexed)

    // Generate calendar
    function generateCalendar(year = currentYear, month = currentMonth) {
      const calendarBody = document.getElementById('calendarBody');
      calendarBody.innerHTML = '';

      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const monthName = new Date(year, month).toLocaleString('default', { month: 'long', year: 'numeric' });
      
      document.getElementById('calendar-month').textContent = monthName;

      // Empty cells for days before month starts
      for (let i = 0; i < firstDay; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'calendar-date-cell empty';
        calendarBody.appendChild(emptyCell);
      }

      // Days of month
      for (let day = 1; day <= daysInMonth; day++) {
        const cell = document.createElement('div');
        cell.className = 'calendar-date-cell';
        cell.textContent = day;
        cell.dataset.date = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

        cell.addEventListener('click', function() {
          selectDate(this.dataset.date, cell);
        });

        calendarBody.appendChild(cell);
      }
    }

    function selectDate(dateStr, cell) {
      const date = new Date(dateStr);

      // If no check-in, set check-in
      if (!checkInDate) {
        checkInDate = date;
        updateCalendar();
      }
      // If check-in exists and no check-out, set check-out
      else if (!checkOutDate) {
        // Make sure check-out is after check-in
        if (date > checkInDate) {
          checkOutDate = date;
          updateCalendar();
        } else {
          // If selected date is before check-in, reset and make it new check-in
          checkInDate = date;
          checkOutDate = null;
          updateCalendar();
        }
      }
      // Both dates selected, reset
      else {
        checkInDate = date;
        checkOutDate = null;
        updateCalendar();
      }

      updateCounter();
    }

    function updateCalendar() {
      const cells = document.querySelectorAll('.calendar-date-cell');
      cells.forEach(cell => {
        if (cell.classList.contains('empty')) return;

        const cellDate = new Date(cell.dataset.date);
        cell.classList.remove('selected', 'in-range', 'range-end');

        if (checkInDate && cellDate.getTime() === checkInDate.getTime()) {
          cell.classList.add('selected');
        } else if (checkOutDate && cellDate.getTime() === checkOutDate.getTime()) {
          cell.classList.add('range-end');
        } else if (checkInDate && checkOutDate && cellDate > checkInDate && cellDate < checkOutDate) {
          cell.classList.add('in-range');
        }
      });
    }

    function updateCounter() {
      const checkInText = document.getElementById('checkInText');
      const checkOutText = document.getElementById('checkOutText');
      const nightsText = document.getElementById('nightsText');
      const findBtn = document.getElementById('findBtn');

      if (checkInDate) {
        const checkInFormatted = checkInDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
        checkInText.innerHTML = `<strong>Check-in:</strong> ${checkInFormatted}`;
      }

      if (checkOutDate) {
        const checkOutFormatted = checkOutDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
        checkOutText.innerHTML = `<strong>Check-out:</strong> ${checkOutFormatted}`;

        // Calculate nights
        const nights = Math.ceil((checkOutDate - checkInDate) / (1000 * 60 * 60 * 24));
        nightsText.innerHTML = `<strong>Total Nights:</strong> ${nights}`;

        // Enable button
        findBtn.disabled = false;
        findBtn.style.opacity = '1';
      } else {
        checkOutText.innerHTML = `<strong>Check-out:</strong> Select a date`;
        nightsText.innerHTML = `<strong>Total Nights:</strong> 0`;
        findBtn.disabled = true;
        findBtn.style.opacity = '0.5';
      }
    }

    // Initialize calendar
    document.addEventListener('DOMContentLoaded', function() {
      generateCalendar(currentYear, currentMonth);
      updateCounter();

      // Previous month
      document.getElementById('prevBtn').addEventListener('click', function() {
        currentMonth--;
        if (currentMonth < 0) {
          currentMonth = 11;
          currentYear--;
        }
        generateCalendar(currentYear, currentMonth);
      });

      // Next month
      document.getElementById('nextBtn').addEventListener('click', function() {
        currentMonth++;
        if (currentMonth > 11) {
          currentMonth = 0;
          currentYear++;
        }
        generateCalendar(currentYear, currentMonth);
      });
    });
  </script>
</body>
</html>