<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book Your Stay - Community Housing Platform</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Hero Section -->
  <div class="housing-booking-hero">
    <div class="hero-icon">📅</div>
    <h1>Book Your Stay</h1>
    <p>Select your dates and complete your booking</p>
  </div>

  <!-- Booking Container -->
  <div class="booking-container">
    <!-- Community Details Section -->
    <div class="community-booking-details">
      <!-- Community Image -->
      <div class="booking-community-image">
        <img src="<%= community.image_url || 'https://via.placeholder.com/400x300' %>" 
             alt="<%= community.name %>"
             onerror="this.src='https://via.placeholder.com/400x300?text=Community'">
      </div>

      <!-- Community Info -->
      <div class="booking-community-info">
        <div class="community-label">SELECTED COMMUNITY</div>
        <h2><%= community.name %></h2>
        
        <div class="community-meta">
          <div class="meta-item">
            <i class="fas fa-map-marker-alt"></i>
            <div>
              <div class="meta-label">Location</div>
              <div class="meta-value"><%= community.location %>, <%= community.city %></div>
            </div>
          </div>

          <div class="meta-item">
            <i class="fas fa-users"></i>
            <div>
              <div class="meta-label">Community Size</div>
              <div class="meta-value"><%= community.residents_count %> residents</div>
            </div>
          </div>

          <div class="meta-item">
            <i class="fas fa-dollar-sign"></i>
            <div>
              <div class="meta-label">Price per Night</div>
              <div class="meta-value">$<%= community.price_per_night %></div>
            </div>
          </div>
        </div>

        <!-- Tags -->
        <% if (community.tags && community.tags.length > 0) { %>
          <div class="booking-tags">
            <% community.tags.slice(0, 3).forEach(tag => { %>
              <span class="booking-tag"><%= tag %></span>
            <% }); %>
          </div>
        <% } %>

        <!-- Amenities -->
        <% if (community.amenities && community.amenities.length > 0) { %>
          <div class="booking-amenities">
            <h4>Amenities</h4>
            <ul>
              <% community.amenities.slice(0, 4).forEach(amenity => { %>
                <li><i class="fas fa-check-circle"></i> <%= amenity %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Calendar & Price Section -->
    <div class="calendar-price-section">
      <!-- Calendar -->
      <div class="booking-calendar-wrapper">
        <div class="calendar-controls">
          <button class="btn-calendar-nav" id="prevBtn">← Previous Month</button>
          <h3 id="calendar-month">April 2025</h3>
          <button class="btn-calendar-nav" id="nextBtn">Next Month →</button>
        </div>

        <div class="booking-calendar">
          <div class="calendar-header-row">
            <div class="calendar-header-cell">Mon</div>
            <div class="calendar-header-cell">Tue</div>
            <div class="calendar-header-cell">Wed</div>
            <div class="calendar-header-cell">Thu</div>
            <div class="calendar-header-cell">Fri</div>
            <div class="calendar-header-cell">Sat</div>
            <div class="calendar-header-cell">Sun</div>
          </div>

          <div class="calendar-body" id="calendarBody">
           
          </div>
        </div>
      </div>

      <!-- Price Summary -->
      <div class="price-summary-booking">
        <h3>Price Details</h3>
        
        <div class="selected-dates-summary">
          <p id="checkInSummary"><strong>Check-in:</strong> <span>Select date</span></p>
          <p id="checkOutSummary"><strong>Check-out:</strong> <span>Select date</span></p>
          <p id="nightsSummary"><strong>Nights:</strong> <span>0</span></p>
        </div>

        <div class="price-breakdown-summary">
          <div class="price-line">
            <span id="priceLabel">$<%= community.price_per_night %> × 0 nights</span>
            <span id="subtotalPrice">$0.00</span>
          </div>
          <div class="price-line">
            <span>Service Fee (10%)</span>
            <span id="serviceFeePrice">$0.00</span>
          </div>
          <div class="price-line">
            <span>Taxes (8%)</span>
            <span id="taxesPrice">$0.00</span>
          </div>
          <div class="price-divider"></div>
          <div class="price-line total">
            <span>Total</span>
            <span id="totalPrice">$0.00</span>
          </div>
        </div>

        <!-- Complete Booking Button -->
        <button id="completeBookingBtn" class="btn-complete-booking" disabled style="opacity: 0.5;">
          <i class="fas fa-calendar-check"></i> Complete Booking
        </button>

        <p style="text-align: center; color: var(--text-light); margin-top: 1rem; font-size: 0.9rem;">
          <i class="fas fa-shield-alt"></i> Secure booking
        </p>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script>
    const communityId = '<%= community.id %>';
    const pricePerNight = parseFloat('<%= community.price_per_night %>');

    let checkInDate = null;
    let checkOutDate = null;
    let currentYear = 2025;
    let currentMonth = 3; 

    // Generate calendar
    function generateCalendar(year = currentYear, month = currentMonth) {
      const calendarBody = document.getElementById('calendarBody');
      calendarBody.innerHTML = '';

      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const monthName = new Date(year, month).toLocaleString('default', { month: 'long', year: 'numeric' });
      
      document.getElementById('calendar-month').textContent = monthName;

      // Empty cells for days before month starts
      for (let i = 0; i < firstDay; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'calendar-date-cell empty';
        calendarBody.appendChild(emptyCell);
      }

      // Days of month
      for (let day = 1; day <= daysInMonth; day++) {
        const cell = document.createElement('div');
        cell.className = 'calendar-date-cell';
        cell.textContent = day;
        cell.dataset.date = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

        cell.addEventListener('click', function() {
          selectDate(this.dataset.date, cell);
        });

        calendarBody.appendChild(cell);
      }
    }

    function selectDate(dateStr, cell) {
      const date = new Date(dateStr);

      // If no check-in, set check-in
      if (!checkInDate) {
        checkInDate = date;
        updateCalendar();
      }
      
      else if (!checkOutDate) {
        
        if (date > checkInDate) {
          checkOutDate = date;
          updateCalendar();
        } else {
          // If selected date is before check-in, reset and make it new check-in
          checkInDate = date;
          checkOutDate = null;
          updateCalendar();
        }
      }

      else {
        checkInDate = date;
        checkOutDate = null;
        updateCalendar();
      }

      updatePriceSummary();
    }

    function updateCalendar() {
      const cells = document.querySelectorAll('.calendar-date-cell');
      cells.forEach(cell => {
        if (cell.classList.contains('empty')) return;

        const cellDate = new Date(cell.dataset.date);
        cell.classList.remove('selected', 'in-range', 'range-end');

        if (checkInDate && cellDate.getTime() === checkInDate.getTime()) {
          cell.classList.add('selected');
        } else if (checkOutDate && cellDate.getTime() === checkOutDate.getTime()) {
          cell.classList.add('range-end');
        } else if (checkInDate && checkOutDate && cellDate > checkInDate && cellDate < checkOutDate) {
          cell.classList.add('in-range');
        }
      });
    }

    function updatePriceSummary() {
      const checkInSummary = document.getElementById('checkInSummary');
      const checkOutSummary = document.getElementById('checkOutSummary');
      const nightsSummary = document.getElementById('nightsSummary');
      const completeBtn = document.getElementById('completeBookingBtn');

      if (checkInDate) {
        const checkInFormatted = checkInDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        checkInSummary.innerHTML = `<strong>Check-in:</strong> <span>${checkInFormatted}</span>`;
      }

      if (checkOutDate) {
        const checkOutFormatted = checkOutDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        checkOutSummary.innerHTML = `<strong>Check-out:</strong> <span>${checkOutFormatted}</span>`;

        // Calculate nights and prices
        const nights = Math.ceil((checkOutDate - checkInDate) / (1000 * 60 * 60 * 24));
        const subtotal = pricePerNight * nights;
        const serviceFee = Math.round(subtotal * 0.1); // 10% service fee
        const taxes = Math.round((subtotal + serviceFee) * 0.08); // 8% tax :) uncle sam needs it cut
        const total = subtotal + serviceFee + taxes;

        nightsSummary.innerHTML = `<strong>Nights:</strong> <span>${nights}</span>`;
        document.getElementById('priceLabel').textContent = `$${pricePerNight} × ${nights} night${nights > 1 ? 's' : ''}`;
        document.getElementById('subtotalPrice').textContent = `$${subtotal.toFixed(2)}`;
        document.getElementById('serviceFeePrice').textContent = `$${serviceFee.toFixed(2)}`;
        document.getElementById('taxesPrice').textContent = `$${taxes.toFixed(2)}`;
        document.getElementById('totalPrice').textContent = `$${total.toFixed(2)}`;

        // Enable button
        completeBtn.disabled = false;
        completeBtn.style.opacity = '1';
        completeBtn.innerHTML = `<i class="fas fa-lock"></i> Complete Booking - $${total.toFixed(2)}`;

        // Set button action to go to payment page
        completeBtn.onclick = function() {
          const checkInStr = checkInDate.toISOString().split('T')[0];
          const checkOutStr = checkOutDate.toISOString().split('T')[0];
          window.location.href = `/payment/${communityId}?checkIn=${checkInStr}&checkOut=${checkOutStr}`;
        };
      } else {
        checkOutSummary.innerHTML = `<strong>Check-out:</strong> <span>Select date</span>`;
        nightsSummary.innerHTML = `<strong>Nights:</strong> <span>0</span>`;
        document.getElementById('priceLabel').textContent = `$${pricePerNight} × 0 nights`;
        document.getElementById('subtotalPrice').textContent = `$0.00`;
        document.getElementById('serviceFeePrice').textContent = `$0.00`;
        document.getElementById('taxesPrice').textContent = `$0.00`;
        document.getElementById('totalPrice').textContent = `$0.00`;
        completeBtn.disabled = true;
        completeBtn.style.opacity = '0.5';
      }
    }

    // Initialize calendar
    document.addEventListener('DOMContentLoaded', function() {
      generateCalendar(currentYear, currentMonth);
      updatePriceSummary();

      // Previous month
      document.getElementById('prevBtn').addEventListener('click', function() {
        currentMonth--;
        if (currentMonth < 0) {
          currentMonth = 11;
          currentYear--;
        }
        generateCalendar(currentYear, currentMonth);
      });

      // Next month
      document.getElementById('nextBtn').addEventListener('click', function() {
        currentMonth++;
        if (currentMonth > 11) {
          currentMonth = 0;
          currentYear++;
        }
        generateCalendar(currentYear, currentMonth);
      });
    });
  </script>
</body>
</html>