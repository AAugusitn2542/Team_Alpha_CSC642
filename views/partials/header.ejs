<!DOCTYPE html>
<html lang="en">
  <!-- fix the <a href="/communities">Communities</a> -->
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Community Housing Platform</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-container">
        <div class="nav-left">
          <a href="/">Find A Home</a>
          <a href="/discover">Communities</a>
          <a href="/faq">FAQ</a>
          <a href="/booking">Housing Booking</a>
        </div>
        <div class="nav-right">
          <button class="icon-btn" title="Favorites">
            <i class="far fa-heart"></i>
          </button>
          <button class="icon-btn" title="Notifications">
            <i class="far fa-bell"></i>
          </button>
          <div class="user-menu">
            <button class="icon-btn user-btn" id="userMenuBtn">
              <i class="far fa-user"></i>
            </button>
            <div class="dropdown-menu" id="userDropdown">
              <% if (user) { %>
              <div class="dropdown-header">
                <p>
                  <strong><%= user.first_name %> <%= user.last_name %></strong>
                </p>
                <p class="user-email"><%= user.email %></p>
              </div>
              <div class="dropdown-divider"></div>
              <a href="/booking" class="dropdown-item">
                <i class="fas fa-calendar"></i> My Bookings
              </a>
              <a href="/auth/logout" class="dropdown-item">
                <i class="fas fa-sign-out-alt"></i> Logout
              </a>
              <% } else { %>
              <a
                href="#"
                class="dropdown-item"
                onclick="showLoginModal(); return false;"
              >
                <i class="fas fa-sign-in-alt"></i> Login
              </a>
              <a
                href="#"
                class="dropdown-item"
                onclick="showSignupModal(); return false;"
              >
                <i class="fas fa-user-plus"></i> Sign Up
              </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <div id="loginModal" class="modal">
      <div class="modal-content">
        <span class="close" onclick="closeLoginModal()">&times;</span>
        <h2>Login</h2>
        <form id="loginForm">
          <div class="form-group">
            <label for="loginEmail">Email</label>
            <input type="email" id="loginEmail" name="email" required />
          </div>
          <div class="form-group">
            <label for="loginPassword">Password</label>
            <input
              type="password"
              id="loginPassword"
              name="password"
              required
            />
          </div>
          <div id="loginError" class="error-message"></div>
          <button type="submit" class="btn btn-primary">Login</button>
          <p class="modal-footer-text">
            Don't have an account?
            <a
              href="#"
              onclick="showSignupModal(); closeLoginModal(); return false;"
              >Sign up</a
            >
          </p>
        </form>
      </div>
    </div>

    <div id="signupModal" class="modal">
      <div class="modal-content">
        <span class="close" onclick="closeSignupModal()">&times;</span>
        <h2>Sign Up</h2>
        <form id="signupForm">
          <div class="form-group">
            <label for="signupFirstName">First Name</label>
            <input type="text" id="signupFirstName" name="firstName" required />
          </div>
          <div class="form-group">
            <label for="signupLastName">Last Name</label>
            <input type="text" id="signupLastName" name="lastName" required />
          </div>
          <div class="form-group">
            <label for="signupEmail">Email</label>
            <input type="email" id="signupEmail" name="email" required />
          </div>
          <div class="form-group">
            <label for="signupPassword">Password</label>
            <input
              type="password"
              id="signupPassword"
              name="password"
              required
            />
          </div>
          <div id="signupError" class="error-message"></div>
          <button type="submit" class="btn btn-primary">Sign Up</button>
          <p class="modal-footer-text">
            Already have an account?
            <a
              href="#"
              onclick="showLoginModal(); closeSignupModal(); return false;"
              >Login</a
            >
          </p>
        </form>
      </div>
    </div>

    <div id="successModal" class="modal">
      <div class="modal-content success-modal">
        <div class="success-icon">
          <i class="fas fa-check-circle"></i>
        </div>
        <h2>Thank You!</h2>
        <p id="successMessage">Your payment has been successful</p>
        <button class="btn btn-primary" onclick="closeSuccessModal()">
          Close
        </button>
      </div>
    </div>

    <!--<script src="/js/auth.js"></script>
    <script src="/js/main.js"></script> -->
  </body>
</html>
